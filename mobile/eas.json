{
  "cli": {
    "version": ">= 13.5.2",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_API_URL": "https://savefood-api.onrender.com/api/"
      }
    },
    "preview": {
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://savefood-api.onrender.com/api/"
      }
    },
    "production": {
      "env": {
        "EXPO_PUBLIC_API_URL": "https://savefood-api.onrender.com/api/"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
